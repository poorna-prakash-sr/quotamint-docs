        "pages": [
          "guides/choose-integration",
          "guides/rest-api-any-language",
          "guides/environments",
          "guides/api-keys",
          "guides/customers-plans",
          "guides/features-entitlements",
          "guides/credits",
          "guides/usage-events",
          "guides/idempotency",
          "guides/webhooks"
        ]
      },
      {
        "group": "API reference",
        "pages": [
          "api/overview",
          "api/authentication",
          "api/check",
          "api/consume",
          "api/events",
          "api/internal",
          "api/errors",
          "api/health"
        ]
      },
      {
        "group": "Dashboard",
        "pages": [
          "dashboard/authentication",
          "dashboard/workspaces",
          "dashboard/usage-and-audit"
        ]
      },
      {
        "group": "Production",
        "pages": [
          "production/local-development",
          "production/security",
          "production/deploy",
          "production/limits",
          "production/troubleshooting"
        ]
      },
      {
